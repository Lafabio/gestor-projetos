rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Professor (mesma lógica das regras do Firestore).
    function professor() {
      return request.auth != null && (
        request.auth.token.email == 'lafaietep@gmail.com' ||
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil == 'professor'
      );
    }

    // Pasta por projeto: leitura para qualquer usuário logado; gravação só professor.
    match /projetos/{pid}/{file=**} {
      allow read: if request.auth != null;
      allow write: if professor();
    }

    // Qualquer outro caminho permanece bloqueado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}