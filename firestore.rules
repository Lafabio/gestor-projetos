rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Professor é o usuário cujo perfil em /usuarios tem perfil == 'professor'
    // (ou o e-mail administrador lafaietep@gmail.com).
    function professor() {
      return request.auth != null &&
        (request.auth.token.email == 'lafaietep@gmail.com' ||
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'professor');
    }

    // Perfis: cada usuário cria e edita somente o próprio perfil; todos podem ler.
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
    }

    // Projetos: leitura para qualquer usuário logado; gravação só professor.
    // Exceção: quem possui a chave do link (devolve 'codigoAcesso' inalterado)
    // pode se adicionar a si mesmo em 'membros' (alteração apenas desse campo).
    match /projetos/{pid} {
      allow read: if request.auth != null;
      allow create, update, delete: if professor();
      allow update: if request.auth != null &&
        ('codigoAcesso' in resource.data) &&
        request.resource.data.codigoAcesso == resource.data.codigoAcesso &&
        request.auth.uid in request.resource.data.membros &&
        !(request.auth.uid in resource.data.membros) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros']);
    }

    // Grupos de trabalho: leitura para qualquer usuário logado; gravação só professor.
    // Exceções (o usuário se adiciona a si mesmo, sem tocar no resto):
    //  1) Convite por e-mail: e-mail em 'convites' → pode alterar só 'membros'+'convites'.
    //  2) Link de acesso: quem possui a chave (devolve 'codigoAcesso' inalterado)
    //     pode alterar só 'membros'.
    match /grupos/{gid} {
      allow read: if request.auth != null;
      allow create, update, delete: if professor();
      allow update: if request.auth != null &&
        ('convites' in resource.data) &&
        request.auth.token.email in resource.data.convites &&
        request.auth.uid in request.resource.data.membros &&
        !(request.auth.uid in resource.data.membros) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros', 'convites']);
      allow update: if request.auth != null &&
        ('codigoAcesso' in resource.data) &&
        request.resource.data.codigoAcesso == resource.data.codigoAcesso &&
        request.auth.uid in request.resource.data.membros &&
        !(request.auth.uid in resource.data.membros) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros']);
    }

    // Cartões: leitura para qualquer usuário logado; gravação só professor.
    match /cartoes/{cid} {
      allow read: if request.auth != null;
      allow create, update, delete: if professor();
    }
  }
}